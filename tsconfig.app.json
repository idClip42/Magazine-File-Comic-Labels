    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true
    },
    "include": [
        "web/src/**/*.ts",
        "web/src/**/*.vue",
        "src/color.ts",
        "src/types.ts",
        "vite.config.ts"
    ]
}
