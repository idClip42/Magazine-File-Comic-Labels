{
  "name": "magazine-file-comic-labels",
  "version": "2.0.0",
  "private": true,
  "description": "A static generator for vinyl comic magazine-file labels.",
  "scripts": {
    "audit:assets": "ts-node src/tools/audit/index.ts",
    "validate:catalog": "ts-node src/tools/audit/validate-catalog.ts",
    "check": "npm run typecheck && npm run test && npm run validate:catalog && npm run audit:assets",
    "apply:harvested-covers": "ts-node src/tools/catalog/apply-marvel-covers.ts",
    "apply:ultimate-marvel-covers": "ts-node src/tools/catalog/apply-ultimate-marvel-covers.ts",
    "apply:annual-marvel-covers": "ts-node src/tools/catalog/apply-annual-marvel-covers.ts",
    "append:additional-marvel-covers": "ts-node src/tools/catalog/append-additional-marvel-covers.ts",
    "build": "npm run build:server && npm run cache:migrate && npm run build:app && node dist/src/build/index.js",
    "build:app": "vite build",
    "build:server": "tsc",
    "harvest:marvel-pages": "ts-node src/tools/research/marvel/harvest-issue-pages.ts --out docs/research/marvel/MARVEL-ISSUE-PAGES.json",
    "harvest:marvel-covers": "ts-node src/tools/research/marvel/harvest-covers.ts",
    "harvest:ultimate-marvel-covers": "ts-node src/tools/research/marvel/harvest-additional-covers.ts --pages docs/research/marvel/MARVEL-ULTIMATE-ISSUE-PAGES.json --out docs/research/marvel/MARVEL-ULTIMATE-COVER-URLS.json",
    "harvest:ultimate-marvel-pages": "ts-node src/tools/research/marvel/harvest-additional-pages.ts --runs docs/research/marvel/MARVEL-ULTIMATE-RUNS.json --out docs/research/marvel/MARVEL-ULTIMATE-ISSUE-PAGES.json",
    "harvest:additional-marvel-covers": "ts-node src/tools/research/marvel/harvest-additional-covers.ts",
    "harvest:additional-marvel-pages": "ts-node src/tools/research/marvel/harvest-additional-pages.ts",
    "harvest:annual-marvel-covers": "ts-node src/tools/research/marvel/harvest-additional-covers.ts --pages docs/research/marvel/MARVEL-ANNUAL-ISSUE-PAGES.json --out docs/research/marvel/MARVEL-ANNUAL-COVER-URLS.json",
    "harvest:annual-marvel-pages": "ts-node src/tools/research/marvel/harvest-additional-pages.ts --runs docs/research/marvel/MARVEL-ANNUAL-RUNS.json --out docs/research/marvel/MARVEL-ANNUAL-ISSUE-PAGES.json",
    "harvest:non-marvel-covers": "ts-node src/tools/research/non-marvel/harvest-covers.ts",
    "harvest:young-justice-covers": "ts-node src/tools/research/non-marvel/harvest-young-justice.ts",
    "harvest:teen-titans-go-covers": "ts-node src/tools/research/non-marvel/harvest-teen-titans-go.ts",
    "harvest:jonny-quest-covers": "ts-node src/tools/research/non-marvel/harvest-jonny-quest.ts",
    "apply:non-marvel-covers": "ts-node src/tools/catalog/apply-non-marvel-covers.ts",
    "normalize:harvested-covers": "ts-node src/tools/research/marvel/normalize-cover-urls.ts",
    "prepare:logos": "ts-node src/tools/logos/prepare.ts",
    "cache:migrate": "ts-node src/tools/migration/migrate-artwork-cache.ts",
    "serve": "npm run cache:migrate && node dist/src/editor-server/index.js",
    "start": "npm run build && npm run serve",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p tsconfig.app.json",
    "test": "npm run build:server && node --test dist/src/core/catalog-json.test.js dist/src/core/catalog-validation.test.js dist/src/core/crop.test.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.13",
    "@vitejs/plugin-vue": "^6.0.8",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vite": "^8.1.5",
    "vue-tsc": "^3.3.8"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "pinia": "^4.0.2",
    "vue": "^3.5.40"
  }
}
