{
  "name": "magazine-file-comic-labels",
  "version": "2.0.0",
  "private": true,
  "description": "A static generator for vinyl comic magazine-file labels.",
  "scripts": {
    "audit:assets": "ts-node src/tools/audit/index.ts",
    "validate:catalog": "ts-node src/tools/audit/validate-catalog.ts",
    "check": "npm run typecheck && npm run test && npm run validate:catalog && npm run validate:research && npm run audit:assets",
    "apply:harvested-covers": "ts-node src/tools/catalog/apply-marvel-covers.ts",
    "build": "npm run build:server && npm run cache:migrate && npm run build:app && node dist/src/build/index.js",
    "build:app": "vite build",
    "build:server": "tsc",
    "harvest:marvel": "ts-node src/tools/research/marvel/harvest.ts",
    "harvest:non-marvel-covers": "ts-node src/tools/research/non-marvel/harvest-hipcomic-covers.ts",
    "harvest:non-marvel-profile": "ts-node src/tools/research/non-marvel/harvest-profiles.ts",
    "harvest:young-justice-covers": "npm run harvest:non-marvel-profile -- --profile young-justice-coverbrowser",
    "harvest:teen-titans-go-covers": "npm run harvest:non-marvel-profile -- --profile teen-titans-go-fandom",
    "harvest:jonny-quest-covers": "npm run harvest:non-marvel-profile -- --profile jonny-quest-fandom",
    "apply:non-marvel-covers": "ts-node src/tools/catalog/apply-non-marvel-covers.ts",
    "normalize:harvested-covers": "ts-node src/tools/research/marvel/normalize-cover-urls.ts",
    "prepare:logos": "ts-node src/tools/logos/prepare.ts",
    "cache:migrate": "ts-node src/tools/migration/migrate-artwork-cache.ts",
    "serve": "npm run cache:migrate && node dist/src/editor-server/index.js",
    "start": "npm run build && npm run serve",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p tsconfig.app.json",
    "test": "npm run build:server && node --test dist/src/core/assets.test.js dist/src/core/catalog-json.test.js dist/src/core/catalog-validation.test.js dist/src/core/crop.test.js dist/src/core/layout.test.js dist/src/editor-server/artwork.test.js dist/src/editor-server/manual-artwork-flow.test.js dist/src/tools/research/shared/inventory.test.js",
    "validate:research": "ts-node src/tools/audit/validate-research.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.13",
    "@vitejs/plugin-vue": "^6.0.8",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vite": "^8.1.5",
    "vue-tsc": "^3.3.8"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "pinia": "^4.0.2",
    "vue": "^3.5.40"
  }
}
