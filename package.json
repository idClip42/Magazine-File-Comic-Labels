{
  "name": "magazine-file-comic-labels",
  "version": "2.0.0",
  "private": true,
  "description": "A static generator for vinyl comic magazine-file labels.",
  "scripts": {
    "audit:assets": "ts-node src/audit-cli.ts",
    "apply:harvested-covers": "ts-node src/apply-harvested-covers-cli.ts",
    "append:additional-marvel-covers": "ts-node src/append-additional-harvested-covers-cli.ts",
    "build": "npm run build:server && npm run build:app && node dist/src/index.js",
    "build:app": "vite build",
    "build:server": "tsc",
    "convert:v1": "ts-node scripts/convert-v1-config.ts",
    "convert:v1:force": "ts-node scripts/convert-v1-config.ts --force",
    "harvest:marvel-pages": "ts-node src/marvel-issue-pages-cli.ts",
    "harvest:marvel-covers": "ts-node src/marvel-cover-urls-cli.ts",
    "harvest:additional-marvel-covers": "ts-node src/marvel-additional-covers-cli.ts",
    "harvest:additional-marvel-pages": "ts-node src/marvel-additional-pages-cli.ts",
    "normalize:harvested-covers": "ts-node src/normalize-harvested-cover-urls-cli.ts",
    "prepare:logos": "ts-node src/logo-prep-cli.ts",
    "serve": "node dist/src/editor-server.js",
    "start": "npm run build && npm run serve",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p tsconfig.app.json"
  },
  "devDependencies": {
    "@types/node": "^24.0.13",
    "@vitejs/plugin-vue": "^6.0.8",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vite": "^8.1.5",
    "vue-tsc": "^3.3.8"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "pinia": "^4.0.2",
    "vue": "^3.5.40"
  }
}
