{
  "name": "magazine-file-comic-labels",
  "version": "2.0.0",
  "private": true,
  "description": "A static generator for vinyl comic magazine-file labels.",
  "scripts": {
    "audit:assets": "ts-node src/audit-cli.ts",
    "build": "tsc && node dist/src/index.js",
    "convert:v1": "ts-node scripts/convert-v1-config.ts",
    "convert:v1:force": "ts-node scripts/convert-v1-config.ts --force",
    "prepare:logos": "ts-node src/logo-prep-cli.ts",
    "start": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.13",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
